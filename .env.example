NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
CRON_SECRET=any-long-random-string

# When the daily shared hour starts (24h clock, Riyadh time). Optional, default 14.
NEXT_PUBLIC_SHARED_HOUR_START=14

# When the DESIGN team's hour starts. Optional — falls back to the core hour.
NEXT_PUBLIC_DESIGN_HOUR_START=

# Public URL of the deployed site (no trailing slash). Set on Vercel so magic
# links always return to production; leave unset locally.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
